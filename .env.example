# Telegram
TELEGRAM_BOT_TOKEN=

# MAX (мессенджер MAX, platform-api2.max.ru)
# Токен из business.max.ru → Чат-боты → Настройки. Храните только в .env.
MAX_BOT_TOKEN=
# Номера телефонов владельца через запятую: доступ по «Поделиться контактом».
MAX_ADMIN_PHONES=+79128770021
# Запасной вход по user_id MAX (можно узнать из лога или события bot_started).
MAX_ADMIN_USER_IDS=
# Каталог данных MAX-бота (состояние отдельно от Telegram).
MAX_DATA_DIR=data_max

# Ozon Seller API
OZON_CLIENT_ID=
OZON_API_KEY=

# Площадка Яндекс Маркет (API-ключ из личного кабинета продавца)
YANDEX_MARKET_API_KEY=

# Доставки: Яндекс Доставка (токен из личного кабинета, раздел «Интеграция»)
YANDEX_DELIVERY_TOKEN=

# Доставки: СДЭК (Account и Secure password из настроек интеграции)
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
CDEK_V1_URL=https://integration.cdek.ru
CDEK_V2_URL=https://api.cdek.ru
# Сколько дней посылка хранится в ПВЗ (используется, если API не вернул точную дату)
CDEK_STORAGE_DAYS=7
# За сколько часов предупреждать об истечении срока хранения
DELIVERY_STORAGE_WARN_HOURS=24

# Необязательно: chat_id владельца. Если пусто, первый /start становится владельцем.
ADMIN_CHAT_ID=

# Порог изменения цены в рублях (уведомление при изменении больше этого значения)
THRESHOLD_RUB=50

# Интервал проверки в секундах (3600 = 1 час)
CHECK_INTERVAL_SEC=3600

# Каталог для данных
DATA_DIR=data

# Tilda Store (только чтение: товары, цены и заказы сайта)
# ID проекта — число из адреса проекта на Тильде.
TILDA_PROJECT_ID=
# Токен MCP Тильды. Храните только в .env на сервере, не коммитьте.
TILDA_MCP_TOKEN=
# Адрес MCP-сервера Тильды (обычно менять не нужно).
TILDA_MCP_URL=https://tilda.ru/api/mcp/
