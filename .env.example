# Telegram
TELEGRAM_BOT_TOKEN=

# Ozon Seller API
OZON_CLIENT_ID=
OZON_API_KEY=

# Доставки: Яндекс Доставка (токен из личного кабинета, раздел «Интеграция»)
YANDEX_DELIVERY_TOKEN=

# Доставки: СДЭК (Account и Secure password из настроек интеграции)
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
CDEK_V1_URL=https://integration.cdek.ru
CDEK_V2_URL=https://api.cdek.ru
# Сколько дней посылка хранится в ПВЗ (используется, если API не вернул точную дату)
CDEK_STORAGE_DAYS=7
# За сколько часов предупреждать об истечении срока хранения
DELIVERY_STORAGE_WARN_HOURS=24

# Необязательно: chat_id владельца. Если пусто, первый /start становится владельцем.
ADMIN_CHAT_ID=

# Порог изменения цены в рублях (уведомление при изменении больше этого значения)
THRESHOLD_RUB=50

# Интервал проверки в секундах (3600 = 1 час)
CHECK_INTERVAL_SEC=3600

# Каталог для данных
DATA_DIR=data